<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.KometaThemes</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!-- A class library does not copy package assemblies to the output folder by default, which
         is why a DLL-only package used to be enough. YoutubeExplode is not shipped by the Jellyfin
         server, so its assemblies have to travel with the plugin and therefore have to be present
         in the build output. The release archive still lists what it packs explicitly, so the
         Jellyfin assemblies that also land here are never shipped. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.8" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.8" />
    <PackageReference Include="System.Linq.Async" Version="6.0.3" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project exercise internal pure helpers (scoring, parsing) directly
         instead of reaching for them through reflection. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Jellyfin.Plugin.KometaThemes.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polly" Version="8.6.5" />
    <PackageReference Include="System.Threading.RateLimiting" Version="9.0.0" />
    <!-- Managed YouTube extractor, so the feature works without an external binary. Its assemblies
         and those of its two dependencies are packed with the plugin; see the release archive. -->
    <PackageReference Include="YoutubeExplode" Version="6.6.0" />
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\*.html" />
    <None Remove="Web\SearchPage.html" />
    <None Remove="Web\ItemButton.js" />
    <None Remove="Web\assets\*.*" />
    <EmbeddedResource Include="Configuration\*.html" />
    <EmbeddedResource Include="Web\SearchPage.html" />
    <EmbeddedResource Include="Web\ItemButton.js" />
    <EmbeddedResource Include="Web\assets\*.*" />
  </ItemGroup>

</Project>
